\f0\fs24 \cf0 let depth = 3; // Recursion depth\
\
function setup() \{\
  createCanvas(600, 600, WEBGL);\
  noStroke();\
\}\
\
function draw() \{\
  background(0);\
  rotateY(frameCount * 0.01); // Rotate for a better view\
  rotateX(frameCount * 0.01);\
\
  // Draw the Menger Sponge\
  mengerSponge(0, 0, 0, 200, depth);\
\}\
\
function mengerSponge(x, y, z, size, depth) \{\
  if (depth === 0) \{\
    push();\
    stroke(115, 104, 59,60);\
    noFill();\
    translate(x, y, z);\
    box(size);\
    pop();\
    return;\
  \}\
\
  let newSize = size / 3;\
  for (let i = -1; i <= 1; i++) \{\
    for (let j = -1; j <= 1; j++) \{\
      for (let k = -1; k <= 1; k++) \{\
        // Skip the center parts\
        if (abs(i) + abs(j) + abs(k) > 1) \{\
          mengerSponge(\
            x + i * newSize,\
            y + j * newSize,\
            z + k * newSize,\
            newSize,\
            depth - 1\
          );\
        \}\
      \}\
    \}\
  \}\
\}}